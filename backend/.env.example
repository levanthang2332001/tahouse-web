PORT=3001
NODE_ENV=development

# Cấu hình MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# JWT Authentication Config
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=7d

# Cloudflare R2 Storage Config
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev

# Cấu hình RAG Chatbot (OpenAI-Compatible)
LLM_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=YOUR_API_KEY_HERE
LLM_MODEL_NAME=gemini-2.5-flash

# Cấu hình ảnh sản phẩm (R2 public URL)
IMAGE_BASE_URL=https://your-r2-bucket.r2.dev

# Cấu hình Zalo tư vấn & lắp đặt
ZALO_PHONE_NUMBER=0379359006
BACKEND_BASE_URL=http://localhost:3001
ZALO_LINK=https://zalo.me/0379359006
